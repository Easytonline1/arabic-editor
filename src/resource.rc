// resource.rc - القائمة ومفاتيح الاختصار (الملف بترميز UTF-8)
#pragma code_page(65001)
#include <windows.h>
#include "resource.h"

// أيقونة البرنامج: ورقة وقلم (يرسمها scripts/make-icon.py)
IDI_APPICON ICON "icon.ico"

// معلومات الإصدار: النصوص السبعة المطلوبة، بالعربية (0x0401) وترميز Unicode (1200)
VS_VERSION_INFO VERSIONINFO
FILEVERSION     1,0,0,0
PRODUCTVERSION  1,0,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040104b0"
        BEGIN
            VALUE "CompanyName",      "مشروع قلم"
            VALUE "FileDescription",  "قلم"
            VALUE "FileVersion",      "1.0.0.0"
            VALUE "InternalName",     "editor"
            VALUE "OriginalFilename", "editor.exe"
            VALUE "ProductName",      "قلم"
            VALUE "ProductVersion",   "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0401, 1200
    END
END

IDR_MAINMENU MENU
BEGIN
    POPUP "&ملف"
    BEGIN
        MENUITEM "&جديد\tCtrl+N",               IDM_FILE_NEW
        MENUITEM "&فتح...\tCtrl+O",             IDM_FILE_OPEN
        MENUITEM "&حفظ\tCtrl+S",                IDM_FILE_SAVE
        MENUITEM "حفظ &باسم...\tCtrl+Shift+S",  IDM_FILE_SAVEAS
        MENUITEM SEPARATOR
        MENUITEM "&خروج",                       IDM_FILE_EXIT
    END
    POPUP "&بحث"
    BEGIN
        MENUITEM "&بحث...\tCtrl+F",              IDM_SEARCH_FIND
        MENUITEM "البحث عن ال&تالي\tF3",        IDM_SEARCH_NEXT
        MENUITEM "ا&ستبدال...\tCtrl+H",          IDM_SEARCH_REPLACE
    END
    POPUP "&عرض"
    BEGIN
        MENUITEM "&التفاف السطور\tCtrl+W",       IDM_VIEW_WORDWRAP
        MENUITEM "&عدّاد الكلمات",              IDM_VIEW_WORDCOUNT
        POPUP "&تكبير"
        BEGIN
            MENUITEM "&تكبير الخط\tCtrl++",       IDM_VIEW_ZOOMIN
            MENUITEM "ت&صغير الخط\tCtrl+-",       IDM_VIEW_ZOOMOUT
            MENUITEM SEPARATOR
            MENUITEM "&الحجم الافتراضي\tCtrl+0",  IDM_VIEW_ZOOMRESET
        END
    END
    POPUP "م&ساعدة"
    BEGIN
        MENUITEM "&حول البرنامج...\tF1",        IDM_HELP_ABOUT
    END
END

IDR_ACCEL ACCELERATORS
BEGIN
    "N", IDM_FILE_NEW,    VIRTKEY, CONTROL
    "O", IDM_FILE_OPEN,   VIRTKEY, CONTROL
    "S", IDM_FILE_SAVE,   VIRTKEY, CONTROL
    "S", IDM_FILE_SAVEAS, VIRTKEY, CONTROL, SHIFT
    "W",         IDM_VIEW_WORDWRAP,  VIRTKEY, CONTROL
    VK_OEM_PLUS, IDM_VIEW_ZOOMIN,    VIRTKEY, CONTROL
    VK_OEM_PLUS, IDM_VIEW_ZOOMIN,    VIRTKEY, CONTROL, SHIFT
    VK_ADD,      IDM_VIEW_ZOOMIN,    VIRTKEY, CONTROL
    VK_OEM_MINUS, IDM_VIEW_ZOOMOUT,  VIRTKEY, CONTROL
    VK_SUBTRACT, IDM_VIEW_ZOOMOUT,   VIRTKEY, CONTROL
    "0",         IDM_VIEW_ZOOMRESET, VIRTKEY, CONTROL
    VK_NUMPAD0,  IDM_VIEW_ZOOMRESET, VIRTKEY, CONTROL
    "F",         IDM_SEARCH_FIND,    VIRTKEY, CONTROL
    VK_F3,       IDM_SEARCH_NEXT,    VIRTKEY
    "H",         IDM_SEARCH_REPLACE, VIRTKEY, CONTROL
    VK_F1,       IDM_HELP_ABOUT,     VIRTKEY
END

// ملف LICENSE من جذر المستودع مضمَّن كما هو لتعرضه نافذة "حول البرنامج"
IDR_LICENSE RCDATA "LICENSE"

// نافذة "حول البرنامج" (معكوسة من اليمين لليسار)
IDD_ABOUT DIALOGEX 0, 0, 330, 262
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_LAYOUTRTL
CAPTION "حول البرنامج"
FONT 9, "MS Shell Dlg 2", 0, 0, 0x1
BEGIN
    LTEXT           "", IDC_ABOUT_TEXT, 10, 8, 310, 74
    EDITTEXT        IDC_ABOUT_LICENSE, 10, 86, 310, 148, ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP
    DEFPUSHBUTTON   "موافق", IDOK, 135, 240, 60, 15, WS_TABSTOP
END

// نافذة البحث والاستبدال (غير مشروطة). في وضع البحث تُخفى عناصر الاستبدال.
IDD_FINDREPLACE DIALOGEX 0, 0, 282, 72
STYLE DS_SETFONT | DS_MODALFRAME | DS_3DLOOK | WS_POPUP | WS_CAPTION | WS_SYSMENU
EXSTYLE WS_EX_LAYOUTRTL
CAPTION "بحث"
FONT 9, "MS Shell Dlg 2", 0, 0, 0x1
BEGIN
    LTEXT           "ابحث عن:", -1, 7, 9, 52, 8
    EDITTEXT        IDC_FIND_TEXT, 62, 7, 134, 13, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT           "استبدل بـ:", IDC_REPLACE_LABEL, 7, 27, 52, 8
    EDITTEXT        IDC_REPLACE_TEXT, 62, 25, 134, 13, ES_AUTOHSCROLL | WS_TABSTOP
    AUTOCHECKBOX    "مطابقة حالة الأحرف", IDC_MATCH_CASE, 7, 50, 190, 10, WS_TABSTOP
    DEFPUSHBUTTON   "البحث عن التالي", IDC_FIND_NEXT, 203, 6, 72, 14, WS_TABSTOP
    PUSHBUTTON      "استبدال", IDC_REPLACE, 203, 24, 72, 14, WS_TABSTOP
    PUSHBUTTON      "إغلاق", IDCANCEL, 203, 42, 72, 14, WS_TABSTOP
END
